---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';

const roles = ['Business owner / Founder / Startup', 'Engineer', 'Hardware / product team', 'Investor', 'Student', 'Other'];
---

<BaseLayout title="Contact" description="Book a free 15-minute 1:1 with Andrii Shylenko on connected hardware, embedded systems and AI products.">
  <section class="container contact">
    <p class="eyebrow">Contact</p>
    <h1>Let's talk</h1>
    <p class="lead">Free 15-min 1:1 on building connected hardware, embedded systems and AI products.</p>

    <div id="contact-sent" class="notice success" role="status" hidden>
      Thanks — your message is on its way. I'll get back to you soon. Please check your spam folder too.
    </div>

    <form id="contact-form" class="card" action="https://api.web3forms.com/submit" method="POST" novalidate>
      <input type="hidden" name="access_key" value={site.web3formsKey} />
      <input type="hidden" name="subject" value="New contact from shylenko.com" />
      <input type="hidden" name="from_name" value="shylenko.com contact form" />
      <input type="hidden" name="redirect" value={`${site.url}/contact/?sent=1`} />
      <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="field">
        <label for="name">Name <span class="req" aria-hidden="true">*</span></label>
        <input id="name" name="name" type="text" autocomplete="name" required />
      </div>

      <fieldset class="field">
        <legend>How can I reach you? <span class="req" aria-hidden="true">*</span></legend>
        <div class="pills">
          <label class="pill"><input type="checkbox" name="reach_via" value="Text me" id="via-text" /><span>Text me</span></label>
          <label class="pill"><input type="checkbox" name="reach_via" value="Email me" id="via-email" checked /><span>Email me</span></label>
        </div>
        <p class="error" id="via-error" hidden>Pick at least one option.</p>
      </fieldset>

      <div class="field" id="email-field">
        <label for="email">Email <span class="req" aria-hidden="true">*</span></label>
        <input id="email" name="email" type="email" autocomplete="email" required />
        <p class="hint">⚠️ My reply could land in your spam folder — check it after submitting, or tick <strong>Text me</strong> as a backup.</p>
      </div>

      <div class="field" id="phone-field">
        <label for="phone">Phone <span class="req" aria-hidden="true">*</span></label>
        <input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="+36 …" />
      </div>

      <div class="field">
        <label for="role">What do you do? <span class="opt">(optional)</span></label>
        <select id="role" name="role">
          <option value="">Choose one…</option>
          {roles.map((r) => <option value={r}>{r}</option>)}
        </select>
      </div>

      <div class="field">
        <label for="message">What would you like to talk about? <span class="opt">(optional)</span></label>
        <textarea id="message" name="message" rows="5"></textarea>
      </div>

      <button class="button" type="submit" id="submit">Send</button>
      <p class="notice error-box" id="form-error" role="alert" hidden>
        Something went wrong sending the form. Please email me directly at <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
    </form>

    <p class="alt">Prefer email? Write to <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>('#contact-form')!;
    const viaText = form.querySelector<HTMLInputElement>('#via-text')!;
    const viaEmail = form.querySelector<HTMLInputElement>('#via-email')!;
    const emailField = form.querySelector<HTMLElement>('#email-field')!;
    const phoneField = form.querySelector<HTMLElement>('#phone-field')!;
    const email = form.querySelector<HTMLInputElement>('#email')!;
    const phone = form.querySelector<HTMLInputElement>('#phone')!;
    const viaError = form.querySelector<HTMLElement>('#via-error')!;
    const formError = form.querySelector<HTMLElement>('#form-error')!;
    const submit = form.querySelector<HTMLButtonElement>('#submit')!;
    const sent = document.querySelector<HTMLElement>('#contact-sent')!;

    if (new URLSearchParams(location.search).get('sent') === '1') {
      sent.hidden = false;
      form.hidden = true;
    }

    const sync = () => {
      emailField.hidden = !viaEmail.checked;
      phoneField.hidden = !viaText.checked;
      email.required = viaEmail.checked;
      phone.required = viaText.checked;
      if (viaEmail.checked || viaText.checked) viaError.hidden = true;
    };
    viaText.addEventListener('change', sync);
    viaEmail.addEventListener('change', sync);
    sync();

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      formError.hidden = true;
      if (!viaEmail.checked && !viaText.checked) {
        viaError.hidden = false;
        viaText.focus();
        return;
      }
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const data = new FormData(form);
      data.set('reach_via', [viaText, viaEmail].filter((c) => c.checked).map((c) => c.value).join(', '));
      data.delete('redirect');
      submit.disabled = true;
      submit.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || json.success === false) throw new Error(json.message || 'Request failed');
        form.hidden = true;
        sent.hidden = false;
        sent.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch {
        formError.hidden = false;
      } finally {
        submit.disabled = false;
        submit.textContent = 'Send';
      }
    });
  </script>
</BaseLayout>

<style>
  .contact { max-width: 640px; padding-block: 56px 72px; }
  .eyebrow { margin: 0 0 6px; color: var(--accent); font-weight: 700; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.06em; }
  h1 { margin: 0 0 10px; font-size: clamp(2rem, 6vw, 2.8rem); line-height: 1.1; }
  .lead { margin: 0 0 28px; color: var(--muted); font-size: 1.1rem; }
  .card { display: flex; flex-direction: column; gap: 20px; padding: 28px; border: 1px solid var(--border); border-radius: 12px; background: var(--surface); }
  .field { display: flex; flex-direction: column; gap: 8px; margin: 0; padding: 0; border: 0; min-width: 0; }
  .field[hidden] { display: none; }
  label, legend { font-weight: 700; padding: 0; }
  legend { margin-bottom: 8px; }
  .req { color: var(--accent); }
  .opt { color: var(--muted); font-weight: 400; font-size: 0.9rem; }
  input[type='text'], input[type='email'], input[type='tel'], select, textarea {
    width: 100%; box-sizing: border-box; padding: 11px 13px; border: 1px solid var(--border); border-radius: 8px;
    background: var(--bg); color: var(--text); font: inherit;
  }
  input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; border-color: var(--accent); }
  textarea { resize: vertical; }
  .pills { display: flex; flex-wrap: wrap; gap: 10px; }
  .pill { position: relative; cursor: pointer; }
  .pill input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .pill span { display: inline-block; padding: 9px 18px; border: 1px solid var(--border); border-radius: 999px; background: var(--bg); font-weight: 600; transition: all 0.15s ease; }
  .pill input:checked + span { background: var(--accent); border-color: var(--accent); color: var(--surface); }
  .pill input:checked + span::before { content: '✓ '; }
  .pill input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  .hint { margin: 0; color: var(--muted); font-size: 0.9rem; }
  .error { margin: 0; color: #c62828; font-size: 0.9rem; }
  .hp { position: absolute; left: -9999px; }
  .button { align-self: flex-start; border: 0; font: inherit; cursor: pointer; }
  .button:disabled { opacity: 0.7; cursor: wait; }
  .notice { margin: 0; padding: 14px 16px; border-radius: 8px; }
  .success { border: 1px solid var(--accent); background: var(--surface); margin-bottom: 20px; }
  .error-box { border: 1px solid #c62828; }
  .alt { margin-top: 20px; color: var(--muted); }
  @media (max-width: 560px) { .contact { padding-block: 32px 48px; } .card { padding: 20px; } .button { align-self: stretch; text-align: center; } }
</style>
