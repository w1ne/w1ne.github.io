---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../data/site';
import { sortNotes, publishedNotes, formatDate } from '../lib/notes';

const projects = (await getCollection('projects')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99) || a.data.name.localeCompare(b.data.name)
);
const recentNotes = sortNotes(publishedNotes(await getCollection('notes'))).slice(0, 6);
---

<BaseLayout>
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow">Founder / embedded systems / applied AI</p>
      <h1>Andrii Shylenko</h1>
      <p>
        I build connected systems, AI tools, and hardware &mdash; from prototype to field.
      </p>
      <div class="actions">
        <a class="button" href={`mailto:${site.email}`}>Discuss a project</a>
        <a class="button secondary" href="/projects/">See projects</a>
      </div>
    </div>
    <figure class="hero-photo">
      <img
        src="/images/andrii-studio-session.jpg"
        alt="Andrii Shylenko presenting to a team during a working session"
        width="1825"
        height="1216"
        loading="eager"
      />
    </figure>
  </section>

  <section class="container section-block">
    <div class="grid two">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
    <p class="section-tail"><a href="/projects/">All projects &rarr;</a></p>
  </section>

  <section class="container section-block">
    <ul class="note-list">
      {recentNotes.map((note) => (
        <li>
          <a href={`/notes/${note.slug}/`}>{note.data.title}</a>
          <time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>
        </li>
      ))}
    </ul>
    <p class="section-tail"><a href="/notes/">All notes &rarr;</a></p>
  </section>

  <section class="container contact-band">
    <div>
      <p class="eyebrow">Contact</p>
      <h2>Building a connected product, AI tool, or embedded platform?</h2>
    </div>
    <a class="button" href={`mailto:${site.email}`}>Email Andrii</a>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: 28px;
    padding-block: 72px 42px;
  }

  @media (min-width: 860px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  h1 {
    margin: 0;
    max-width: 780px;
    font-size: clamp(2.6rem, 8vw, 5.6rem);
    line-height: 0.98;
  }

  .hero-copy > p:not(.eyebrow) {
    max-width: 700px;
    color: var(--muted);
    font-size: 1.25rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .hero-photo {
    margin: 8px 0 0;
  }

  .hero-photo img {
    width: 100%;
    aspect-ratio: 21 / 8;
    object-fit: cover;
    object-position: center 28%;
    border: 1px solid var(--border);
    border-radius: 14px;
  }

  @media (max-width: 560px) {
    .hero-photo img {
      aspect-ratio: 4 / 3;
    }
  }

  .section-block {
    padding-block: 36px;
  }

  .section-tail {
    margin: 18px 0 0;
    text-align: right;
  }

  .section-tail a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .section-tail a:hover {
    color: var(--accent);
  }

  .note-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .note-list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid var(--border);
    padding: 14px 0;
  }

  .note-list a {
    color: var(--text);
    text-decoration: none;
    font-size: 1.05rem;
    line-height: 1.4;
  }

  .note-list a:hover {
    color: var(--accent);
  }

  .note-list time {
    flex: 0 0 auto;
    color: var(--muted);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .note-list li {
      align-items: flex-start;
      flex-direction: column;
      gap: 2px;
    }
  }

  .contact-band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 36px;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
  }

  .contact-band h2 {
    margin: 0;
    font-size: clamp(1.45rem, 4vw, 2.2rem);
  }

  @media (max-width: 700px) {
    .contact-band {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
