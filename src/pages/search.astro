---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate } from '../lib/notes';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((note) => ({
    title: note.data.title,
    description: note.data.description,
    date: formatDate(note.data.date),
    href: `/notes/${note.slug}/`,
    tags: note.data.tags
  }));
---

<BaseLayout title="Search" description="Search notes and articles by title, summary, or tag.">
  <section class="content search-page">
    <p class="eyebrow">Search</p>
    <h1>Search notes.</h1>
    <form class="search-form" role="search">
      <label for="search-query">Search</label>
      <input
        id="search-query"
        type="search"
        name="q"
        autocomplete="off"
        placeholder="IO-Link, UDS, LabWired, darktable..."
      />
    </form>
    <p class="result-count" aria-live="polite"></p>
    <div class="results" data-search-results></div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ notes }}>
  const input = document.querySelector('#search-query');
  const results = document.querySelector('[data-search-results]');
  const count = document.querySelector('.result-count');
  const params = new URLSearchParams(window.location.search);

  const normalize = (value) => value.toLowerCase();
  const render = () => {
    const query = normalize(input.value.trim());
    const terms = query.split(/\s+/).filter(Boolean);
    const matches = terms.length === 0
      ? notes
      : notes.filter((note) => {
          const haystack = normalize(`${note.title} ${note.description} ${note.tags.join(' ')}`);
          return terms.every((term) => haystack.includes(term));
        });

    count.textContent = `${matches.length} ${matches.length === 1 ? 'result' : 'results'}`;
    results.innerHTML = matches.map((note) => `
      <article class="result">
        <p>${note.date}</p>
        <h2><a href="${note.href}">${note.title}</a></h2>
        ${note.description ? `<p>${note.description}</p>` : ''}
        <div>${note.tags.map((tag) => `<span>${tag}</span>`).join('')}</div>
      </article>
    `).join('');
  };

  input.value = params.get('q') || '';
  input.addEventListener('input', render);
  render();
</script>

<style>
  .search-page {
    padding-block: 56px 32px;
  }

  h1 {
    margin: 0 0 24px;
    font-size: clamp(2.2rem, 6vw, 4rem);
    line-height: 1.05;
  }

  .search-form {
    display: grid;
    gap: 8px;
    margin-bottom: 14px;
  }

  label {
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 700;
  }

  input {
    width: 100%;
    min-height: 48px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
    padding: 0 14px;
  }

  input:focus {
    border-color: var(--accent);
    outline: 2px solid color-mix(in srgb, var(--accent) 24%, transparent);
    outline-offset: 2px;
  }

  .result-count {
    color: var(--muted);
    margin: 0 0 18px;
  }

  .results {
    display: grid;
    gap: 16px;
  }

  :global(.result) {
    border-bottom: 1px solid var(--border);
    padding-bottom: 16px;
  }

  :global(.result > *) {
    margin: 0;
  }

  :global(.result h2) {
    margin-top: 4px;
    font-size: 1.25rem;
    line-height: 1.3;
  }

  :global(.result > p:first-child) {
    color: var(--muted);
    font-size: 0.9rem;
  }

  :global(.result > p:not(:first-child)) {
    color: var(--muted);
    margin-top: 6px;
  }

  :global(.result div) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }

  :global(.result span) {
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.78rem;
    padding: 2px 7px;
  }
</style>
